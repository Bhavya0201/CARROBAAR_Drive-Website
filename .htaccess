# Hostinger Clean URLs & SEO Canonical Rewrites
RewriteEngine On

# Ensure HTTPS & Canonical www
RewriteCond %{HTTP_HOST} ^carrobaardrive\.com$ [NC]
RewriteRule ^(.*)$ https://www.carrobaardrive.com/$1 [L,R=301]

# 1. Redirect /index.html to root domain (/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# Redirect legacy /sample-pdi-report to clean /sample-report
RewriteRule ^sample-pdi-report(\.html)?/?$ /sample-report [R=301,L]

# 2. Redirect any /page.html URL to clean extensionless /page URL (except blog & vin-decoder subpages)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html\ HTTP/
RewriteCond %{REQUEST_URI} !^/(blog|vin-decoder)/
RewriteRule ^([^/]+)\.html$ /$1 [R=301,L]

# Redirect /blog/page.html to clean /blog/page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog/([^/]+)\.html\ HTTP/
RewriteRule ^blog/([^/]+)\.html$ /blog/$1 [R=301,L]

# Redirect /vin-decoder/page.html to clean /vin-decoder/page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /vin-decoder/([^/]+)\.html\ HTTP/
RewriteRule ^vin-decoder/([^/]+)\.html$ /vin-decoder/$1 [R=301,L]

# 3. Internally resolve /sample-report to sample-pdi-report.html
RewriteRule ^sample-report/?$ sample-pdi-report.html [L]

# Fallback: If an article is requested at the root domain, redirect to /blog/:slug
RewriteRule ^(10-real-problems-found-in-pdi|15-things-to-check-new-car-pdi|car-resale-value-factors|check-used-car-accident-history|dealer-trust-independent-pdi|ev-vs-petrol-vs-diesel-hybrid|hidden-costs-of-car-ownership|new-car-vs-used-car-financials|pdi-necessary-before-delivery|used-car-buying-checklist-mistakes)(\.html)?/?$ /blog/$1 [R=301,L]

# 4. Internally resolve /page to /page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# 5. Internally resolve /vin-decoder or /vin-decoder/ to vin-decoder/index.html or vin-decoder.html
RewriteRule ^vin-decoder/?$ vin-decoder/index.html [L]

# 6. Internally resolve /vin-decoder/slug to vin-decoder/slug.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^vin-decoder/([^/.]+)/?$ vin-decoder/$1.html [L]

# 7. Internally resolve /blog or /blog/ to blog/index.html
RewriteRule ^blog/?$ blog/index.html [L]

# 8. Internally resolve /blog/slug to blog/slug.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([^/.]+)/?$ blog/$1.html [L]
